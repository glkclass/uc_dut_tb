# setup path to Xilins Vitis tools (may be redefined in .user_env)
VITIS_TOOLS = /tools/Xilinx/2025.1/Vitis

# path to mc scripts log file
MC_LOG=mc_scripts.log

# path to folder containing rtl firmware
FIRMWARE_ROOT_PATH=../..

# path to platform generated by Vivado
XSA_PLATFORM_FILE=${FIRMWARE_ROOT_PATH}/scripts/${VIVADO_XSA_PLATFORM_FILE}

# path to folder containing Vivado project imports
ART_ELF_FOLDER=${FIRMWARE_ROOT_PATH}/scripts/${VIVADO_IMPORTS}

# mc project root path
ROOT_PATH = ..

TOOLS_USED="Tools: $(VITIS_TOOLS)"
SETUP_TOOLS=@source $(VITIS_TOOLS)/settings64.sh
INFO_PREFIX="$$(date +'%H:%M:%S') INFO"
ECHO_HEADER=@echo -e "$(INFO_PREFIX) | Make $@"
ECHO_TOOLS_HEADER=@echo -e "$(INFO_PREFIX) | Make $@ | $(TOOLS_USED)"
ECHO_FOOTER=@echo -e "$(INFO_PREFIX) | Make finished\n"

VITIS_WORKSPACE_PATH=../vitis_ws
VITIS_SRC_PATH=../src
MC_PLATFORM_NAME=oct640_cu_top
MC_APP_NAME=oct640_cu_top_mc
MC_APP_BUILD_CONFIG=RELEASE
MC_FIRMWARE_GITVERSION_HEADER=${VITIS_SRC_PATH}/include/firmware_version.h
MC_FIRMWARE_FLASH_TYPE_HEADER=${VITIS_SRC_PATH}/include/spi_flash_type.h
XSA_PLATFORM_OS=standalone
XSA_PLATFORM_CPU=core_sys_core_mblaze_core
XSA_PLATFORM_OS_STDINOUT_DEBUG=core_sys_core_mdm
XSA_PLATFORM_OS_STDINOUT_RELEASE=core_sys_uart
MC_APP_BUILD_DEFINES_DEBUG="AVV_DEBUG"
MC_APP_BUILD_DEFINES_RELEASE="NDEBUG"
MC_APP_INCLUDE=${VITIS_WORKSPACE_PATH}/${MC_PLATFORM_NAME}/${XSA_PLATFORM_CPU}/standalone_core_sys_core_mblaze_core/bsp/include
