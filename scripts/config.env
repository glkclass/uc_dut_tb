# PROJECT ROOT PATH
ROOT_PATH=..

# VIVADO PROJECT
VIVADO_PROJECT_NAME=vivado_project
VIVADO_PROJECT_FOLDER=../syn/${VIVADO_PROJECT_NAME}
VIVADO_SPI_FLASH_PROPERTY_XDC=../syn/xdc/spi_flash_property.xdc
VIVADO_SPI_FLASH_TYPE_INCLUDE=../rtl/common/spi_flash_type.vh
VIVADO_IMPORTS=../syn/imports
VIVADO_DESIGN_NAME=oct640_cu
VIVADO_DESIGN_TOP_NAME=${VIVADO_DESIGN_NAME}_top
VIVADO_PROJECT_ELF_NAME=${VIVADO_DESIGN_TOP_NAME}_mc.elf
VIVADO_PROJECT=${VIVADO_PROJECT_FOLDER}/${VIVADO_PROJECT_NAME}.xpr
VIVADO_PROJECT_TOP_BD=${VIVADO_PROJECT_FOLDER}/${VIVADO_PROJECT_NAME}.srcs/sources_1/bd/${VIVADO_DESIGN_NAME}/${VIVADO_DESIGN_NAME}.bd
VIVADO_PROJECT_IMPL_FOLDER=${VIVADO_PROJECT_FOLDER}/${VIVADO_PROJECT_NAME}.runs/impl_1
VIVADO_PROJECT_CHECKPOINT_PATTERN=${VIVADO_PROJECT_FOLDER}/${VIVADO_PROJECT_NAME}.srcs/utils_1/imports/{synth_1, impl_1}/*.dcp
VIVADO_XSA_PLATFORM_FILE=${VIVADO_PROJECT_FOLDER}/${VIVADO_DESIGN_TOP_NAME}.xsa
VIVADO_DESIGN_CORE="core_sys/core/mblaze_core"
VIVADO_BIT_STREAM=${VIVADO_PROJECT_IMPL_FOLDER}/${VIVADO_DESIGN_TOP_NAME}.bit
VIVADO_BIN_STREAM=${VIVADO_PROJECT_IMPL_FOLDER}/${VIVADO_DESIGN_TOP_NAME}.bin
VIVADO_BIN_STREAM_SIZE=2
FPGA_DEVICE=xc7a50t_0
FPGA_DEVICE_FULL_NAME=xc7a50tcsg324
FLASH_DEVICE=mt25qu01g-spi-x1_x2_x4


# TOOLS
# setup path to Xilins Vivado tools
VIVADO_TOOLS=/tools/Xilinx/2025.1/Vivado
# setup what tools to use for 'program flash' or 'load fpga' tasks: vivado or vivado_lab
VIVADO_BIN_TOOL=vivado_lab
# num of jobs for vivado impl process
N_JOBS=12


# LOG
# path to  log file
LOG=scripts.log
TOOLS_USED="Tools: $(VIVADO_TOOLS)"
SETUP_TOOLS=@source $(VIVADO_TOOLS)/settings64.sh
INFO_PREFIX="$$(date +'%H:%M:%S') INFO"
ECHO_HEADER=@echo -e "$(INFO_PREFIX) | Make $@"
ECHO_TOOLS_HEADER=@echo -e "$(INFO_PREFIX) | Make $@ | $(TOOLS_USED)"
ECHO_FOOTER=@echo -e "$(INFO_PREFIX) | Make finished\n"


# TOP PROJECT

# Encrypting firmware
AES_KEY_FILE ?=oct640_cu_top.nky
AES256_KEY ?=32345678ABCDDCBA12345678ABCDDCBA12345678ABCDDCBA12345678ABCDDCBA
HMAC256_KEY ?=6a852a19f1075c7d86cd7733a1861b36597eea41b7121dbe41a89304f07da120
STARTCBC128_KEY ?=df78556352efa4c2cfb760dee871f917

# Flash type. Env var Options: x4 - mt25xxx flash used in x4 mode, x1 - mx66xxx flash used in x1 mode
FLASH_SPI_INTERFACE ?=x4
# path to generated env file containing only FLASH_SPI_INTERFACE value
FLASH_SPI_INTERFACE_ENV=flash_spi_interface.env
# path to folder containing microcode project
MC_ROOT_PATH=${ROOT_PATH}/mc
# path to folder to copy build artefacts to (should be redefined in .user_env)
ARTEFACT_FOLDER=.
# path to bin&bit files had copied to separate artefact folder
ARTEFACT_BIN_STREAM=${ARTEFACT_FOLDER}/${VIVADO_DESIGN_TOP_NAME}_flash_${FLASH_SPI_INTERFACE}.bin
ARTEFACT_BIT_STREAM=${ARTEFACT_FOLDER}/${VIVADO_DESIGN_TOP_NAME}.bit
# path to bin&bit files used for 'program flash' tasks
PROGRAM_BIN_STREAM=${ARTEFACT_BIN_STREAM}
PROGRAM_BIT_STREAM=${ARTEFACT_BIT_STREAM}
# path to bin file containing Settings flash firmware
SETTINGS_FLASH_FIRMWARE_BIN=${ARTEFACT_FOLDER}/settings_flash_firmware_placeholder.bin
# path to bin file containing Config & Settings flash firmware
CONFIG_SETTINGS_FLASH_BIN=${ARTEFACT_FOLDER}/config_settings_flash_firmware.bin


# AMS
# path to folder containing am_serial_scripts
AM_SERIAL_SCRIPTS_ROOT_PATH=${ROOT_PATH}/../am_serial_scripts
# port for am_serila_scripts communication
AM_SERIAL_PORT=/dev/ttyUSB0


# DUT_TB
# path to folder containing dut_tb
DUT_TB_ROOT_PATH=${ROOT_PATH}/../oct640_cu_dut_tb/sim/tb/dut_tb
# init name of current test config
DUT_TB_TEST_CONFIG=test_configs/dut_tb_test_0.opt
